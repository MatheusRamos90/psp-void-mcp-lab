# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=pspvoid
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-db-password

# ─── JWT (psp-void-orch) ──────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-minimum-32-characters
JWT_EXPIRATION_MS=86400000

# ─── Service Account (psp-void-tools-orch → psp-void-orch) ───────────────────
SERVICE_EMAIL=tools@pspvoid.internal
SERVICE_PASSWORD=your-service-account-password

# ─── Seed passwords (psp-void-postgres-db initial data) ──────────────────────
# SEED_SERVICE_PASSWORD must match SERVICE_PASSWORD
SEED_ADMIN_PASSWORD=your-admin-initial-password
SEED_SERVICE_PASSWORD=your-service-account-password

# ─── MCP API Key (Cursor → psp-void-tools-orch) ──────────────────────────────
# Must match the X-Api-Key header in .cursor/mcp.json
MCP_API_KEY=your-mcp-api-key
